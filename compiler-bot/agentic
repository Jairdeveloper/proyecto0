#!/usr/bin/env python3
"""RECPL Compiler Bot v2.0 — CLI entrypoint. Compila lenguaje natural a IR canonico."""

from __future__ import annotations

import argparse
import asyncio
import json
import sys

from agentic_pipeline.config import config as pipeline_config
from agentic_pipeline.debugger import PipelineDebugger
from agentic_pipeline.feedback_loop import get_global_feedback
from agentic_pipeline.orchestrator import PipelineOrchestrator
from agentic_pipeline.prompt_chain.cli import add_chain_args, run_chain
from user_request.contracts.enums import RequestChannel
from user_request.contracts.response import ResponseObject
from user_request.layer import UserRequestLayer


def _stream_callback(stage: str, output: object) -> None:
    print(f"[{stage}] completed", file=sys.stderr)


async def main() -> None:
    parser = argparse.ArgumentParser(
        description="RECPL Compiler Bot v2.0 — Natural language to IR code compiler",
    )
    parser.add_argument(
        "--prompt",
        "-p",
        type=str,
        help="User requirement prompt",
    )
    parser.add_argument(
        "--file",
        "-f",
        type=str,
        help="Read prompt from file",
    )
    parser.add_argument(
        "--output",
        "-o",
        type=str,
        default="./output",
        help="Output directory",
    )
    parser.add_argument(
        "--stream",
        action="store_true",
        help="Stream progress to stderr",
    )
    parser.add_argument(
        "--debug",
        type=str,
        choices=["trace", "step", "timing", "inspect"],
        help="Debug mode: trace|step|timing|inspect",
    )
    parser.add_argument(
        "--show-output",
        action="store_true",
        help="Print output_data preview for each stage (use with --debug)",
    )
    parser.add_argument(
        "--dialog",
        action="store_true",
        help="Enable interactive dialog mode for ambiguous prompts",
    )
    parser.add_argument(
        "--no-dialog",
        action="store_true",
        help="Disable interactive dialog for ambiguous prompts",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output as JSON (machine-readable, forces --output-format json)",
    )
    parser.add_argument(
        "--output-format",
        type=str,
        choices=["text", "json"],
        default="text",
        help="Output format: text (human-readable) or json (machine-readable)",
    )
    parser.add_argument(
        "--offline",
        action="store_true",
        help="Run in offline mode (no LLM calls, heuristic only)",
    )
    parser.add_argument(
        "--ir-only",
        action="store_true",
        help="Stop after IR generation and output IR JSON (skip code generation)",
    )
    parser.add_argument(
        "--metrics",
        type=str,
        choices=["json", "table"],
        nargs="?",
        const="json",
        help="Print pipeline metrics summary (json|table)",
    )
    parser.add_argument(
        "--dashboard",
        action="store_true",
        help="Start local dashboard server",
    )
    parser.add_argument(
        "--host",
        type=str,
        default="127.0.0.1",
        help="Dashboard server host (default: 127.0.0.1)",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=8765,
        help="Dashboard server port (default: 8765)",
    )
    add_chain_args(parser)
    args = parser.parse_args()

    if args.dashboard:
        from agentic_pipeline.dashboard.app import run_server

        print(f"Dashboard listening on http://{args.host}:{args.port}")
        run_server(host=args.host, port=args.port)
        sys.exit(0)

    if args.offline:
        pipeline_config.offline = True
    if args.ir_only:
        pipeline_config.ir_only = True

    if args.metrics:
        fb = get_global_feedback()
        summary = fb.summary()
        pc_summary = fb.prompt_chain_summary()
        if args.metrics == "table":
            print("=== Pipeline Metrics Summary ===")
            print(f"Total records: {summary.get('total_records', 0)}")
            print(f"Total errors:  {summary.get('total_errors', 0)}")
            if summary["total_records"] > 0:
                rate = (
                    (summary["total_records"] - summary["total_errors"])
                    * 100
                    / summary["total_records"]
                )
                print(f"Success rate:  {rate:.1f}%")
            print("Per-stage:")
            for stage, count in summary.get("stages", {}).items():
                print(f"  {stage}: {count} records")
            if pc_summary.get("per_stage"):
                print()
                print("Prompt Chain per-stage:")
                for name, stats in pc_summary["per_stage"].items():
                    print(
                        f"  {name}: {stats['calls']} calls, "
                        f"{stats['success_rate']}% success, "
                        f"avg {stats['avg_duration_s']}s"
                    )
                print()
                print(f"Overall success rate: {pc_summary['success_rate']}%")
                print(f"Fallback rate: {pc_summary['fallback_rate']}%")
        else:
            output = dict(summary)
            if pc_summary.get("per_stage"):
                output["prompt_chain"] = pc_summary
            print(json.dumps(output, indent=2))
        sys.exit(0)

    if args.file:
        with open(args.file) as f:
            prompt = f.read()
    elif args.prompt:
        prompt = args.prompt
    else:
        parser.print_help()
        sys.exit(1)

    # Dialog mode: resolver ambiguedades antes de ejecutar el pipeline
    if not args.no_dialog:
        try:
            _layer = UserRequestLayer()
            _request = _layer.process_input(prompt)
            _questions = _layer.resolve_ambiguity(_request)
            if _questions:
                print("[dialog] Se detectaron ambiguedades en la solicitud:",
                      file=sys.stderr)
                for _q in _questions:
                    print(f"? {_q}", file=sys.stderr)
                    _answer = sys.stdin.readline().strip()
                    if _answer:
                        prompt = f"{prompt} {_answer}"
                print(file=sys.stderr)
        except Exception:
            logger = __import__("logging").getLogger(__name__)
            logger.debug("Dialog mode error (non-fatal)", exc_info=True)

    if args.chain:
        result = await run_chain(
            prompt=prompt,
            output_dir=args.output,
            debug_mode=args.debug,
            show_output=args.show_output,
        )
    elif args.debug:
        debugger = PipelineDebugger(
            mode=args.debug,
            output_dir=args.output,
            show_output=args.show_output,
        )
        result = await debugger.run(prompt)
    else:
        cb = _stream_callback if args.stream else None
        orchestrator = PipelineOrchestrator(
            stream_callback=cb,
            output_dir=args.output,
        )
        result = await orchestrator.run(prompt)

    # NLG output formatting
    output_format = "json" if args.json else args.output_format
    channel = RequestChannel.API if output_format == "json" else RequestChannel.CLI
    nlg_layer = UserRequestLayer(channel=channel)
    response_obj = ResponseObject(
        success=result.get("success", True),
        data=result.get("output", {}),
        channel=channel,
    )
    output = nlg_layer.format_output(
        response_obj,
        channel=channel,
        force_ir=args.ir_only,
    )
    print(output)


if __name__ == "__main__":
    asyncio.run(main())
