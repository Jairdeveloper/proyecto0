start: layout+

layout: LAYOUT_KEYWORD (CNAME | COMP_KEYWORD)? component_list?

component_list: (COMP_KEYWORD | CNAME) (CONNECTOR (COMP_KEYWORD | CNAME))*

LAYOUT_KEYWORD: "pagina"i | "seccion"i | "layout"i | "page"i | "section"i
CONNECTOR: "con"i | "y"i | "de"i | "en"i | "para"i | "del"i | "un"i | "una"i
COMP_KEYWORD: "formulario"i | "tabla"i | "grafico"i | "navbar"i | "sidebar"i | "footer"i | "header"i | "modal"i | "card"i | "lista"i | "boton"i | "input"i | "menu"i

%import common.CNAME
%import common.WS
%ignore WS
